# Platform Integration
DRIFTGUARD_BASE_URL=http://localhost:8000
DRIFTGUARD_API_KEY=dg_sample_secret_key
REQUEST_TIMEOUT_SECONDS=30

# LLM Providers
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-sample-secret
ANTHROPIC_API_KEY=sk-ant-sample-secret
OLLAMA_BASE_URL=http://localhost:11434

# OpenTelemetry
OTLP_EXPORTER_ENDPOINT=http://localhost:4317
TELEMETRY_SERVICE_NAME=driftguard-probe
ENABLE_TELEMETRY=true

# Server Config
PROBE_PORT=8001
PROBE_HOST=0.0.0.0
DEBUG_MODE=true
